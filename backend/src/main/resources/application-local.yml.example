# ============================================
# Local Configuration Template
# ============================================
# Copy this file to application-local.yml and fill in your actual credentials
# DO NOT commit application-local.yml to version control
# ============================================

# Datasources Configuration
datasources:
  default:
    url: jdbc:mysql://YOUR_DB_HOST:YOUR_DB_PORT/dify_external?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
    dialect: MYSQL
